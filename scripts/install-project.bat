@echo off
setlocal
where node >nul 2>nul
if errorlevel 1 (
  echo Node.js 22.19+ is required. 1>&2
  exit /b 1
)
node -e "const s=require('fs').readFileSync(process.argv[1],'utf8'); import('data:text/javascript;base64,'+s.split(':::PI_INIT_PAYLOAD:::').pop().trim())" "%~f0" %*
exit /b %errorlevel%
:::PI_INIT_PAYLOAD:::

